    "text": "Dogtushya! Dogtushya!"
  },
  {
    "id": "l6",
    "start": 41.5,
    "end": 47.0,
    "text": "Steady at the door"
  },
  {
    "id": "l7",
    "start": 47.0,
    "end": 52.5,
    "text": "Dogtushya! Dogtushya!"
  },
  {
    "id": "l8",
    "start": 52.5,
    "end": 58.0,
    "text": "Ask her for a little, she will give you more"
  },
  {
