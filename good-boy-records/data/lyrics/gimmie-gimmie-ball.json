    "end": 34.0,
    "text": "Gimmie! Gimmie! Ball!"
  },
  {
    "id": "l7",
    "start": 34.0,
    "end": 38.5,
    "text": "Throw it down the garden, throw it down the hall"
  },
  {
    "id": "l8",
    "start": 38.5,
    "end": 43.0,
    "text": "Gimmie! Gimmie! Ball!"
  },
  {
    "id": "l9",
    "start": 48.0,
    "end": 52.5,
    "text": "Twenty-seven times and you're getting tired"
  },
  {
    "id": "l10",
    "start": 52.5,
    "end": 57.0,
    "text": "Twenty-seven times and I'm still wired"
  },
  {
    "id": "l11",
    "start": 57.0,
    "end": 61.5,
    "text": "You can put your coat on, you can turn out the light"
  },
  {
    "id": "l12",
    "start": 61.5,
    "end": 66.0,
    "text": "I will be here holding it all night"
  },
  {
    "id": "l13",
    "start": 70.0,
    "end": 72.5,
    "text": "Gimmie! Gimmie! Ball!"
  },
  {
    "id": "l14",
    "start": 72.5,
    "end": 75.0,
    "text": "Gimmie! Gimmie! Ball!"
  },
  {
    "id": "l15",
    "start": 75.0,
    "end": 79.5,
    "text": "Nothing in this world has ever mattered more at all"
