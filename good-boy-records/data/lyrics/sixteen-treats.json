[
  {
    "id": "l1",
    "start": 8.0,
    "end": 12.4,
    "text": "Some folks count their money"
  },
  {
    "id": "l2",
    "start": 12.4,
    "end": 16.8,
    "text": "Some folks count their sheep"
  },
  {
    "id": "l3",
    "start": 16.8,
    "end": 21.4,
    "text": "I count what's left in the pocket of a coat"
  },
  {
    "id": "l4",
    "start": 21.4,
    "end": 26.0,
    "text": "Before I go to sleep"
  },
  {
    "id": "l5",
    "start": 28.6,
    "end": 33.2,
    "text": "Sixteen treats and a walk in the rain"
  },
  {
    "id": "l6",
    "start": 33.2,
    "end": 37.8,
    "text": "Sixteen treats and I'd do it again"
  },
  {
    "id": "l7",
    "start": 37.8,
    "end": 42.4,
    "text": "You can keep your silver, keep your gold"
  },
  {
    "id": "l8",
    "start": 42.4,
    "end": 47.0,
    "text": "Sixteen treats is all I hold"
  },
  {
    "id": "l9",
    "start": 52.0,
    "end": 56.6,
    "text": "Boss says sit, and brother, I sit"
  },
  {
    "id": "l10",
    "start": 56.6,
    "end": 61.2,
    "text": "Boss says wait, and I wait a bit"
  },
  {
    "id": "l11",
    "start": 61.2,
    "end": 65.8,
    "text": "But the second that the cupboard makes a sound"
  },
  {
    "id": "l12",
    "start": 65.8,
    "end": 70.4,
    "text": "There ain't a dog in the county gonna hold me down"
  },
  {
    "id": "l13",
    "start": 74.0,
    "end": 78.6,
    "text": "Sixteen treats and a walk in the rain"
  },
  {
    "id": "l14",
    "start": 78.6,
    "end": 83.2,
    "text": "Sixteen treats and I'd do it again"
  },
  {
    "id": "l15",
    "start": 83.2,
    "end": 87.8,
    "text": "Count 'em out slow, count 'em out true"
  },
  {
    "id": "l16",
    "start": 87.8,
    "end": 96.0,
    "text": "Fifteen for me and one for you"
  }
]
