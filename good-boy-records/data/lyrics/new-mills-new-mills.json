[
  {
    "id": "l1",
    "start": 6.0,
    "end": 11.2,
    "text": "Down the hill and under the bridge"
  },
  {
    "id": "l2",
    "start": 11.2,
    "end": 16.4,
    "text": "Where the water runs the colour of tea"
  },
  {
    "id": "l3",
    "start": 16.4,
    "end": 21.6,
    "text": "There's a town that don't remember my name"
  },
  {
    "id": "l4",
    "start": 21.6,
    "end": 26.8,
    "text": "But the town remembers me"
  },
  {
    "id": "l5",
    "start": 30.0,
    "end": 34.2,
    "text": "New Mills, New Mills"
  },
  {
    "id": "l6",
    "start": 34.2,
    "end": 39.4,
    "text": "Say it twice or don't say it at all"
  },
  {
    "id": "l7",
    "start": 39.4,
    "end": 43.6,
    "text": "New Mills, New Mills"
  },
  {
    "id": "l8",
    "start": 43.6,
    "end": 48.8,
    "text": "I'll be home before the evening falls"
  },
  {
    "id": "l9",
    "start": 54.0,
    "end": 59.2,
    "text": "Lead in my hand and mud to the knee"
  },
  {
    "id": "l10",
    "start": 59.2,
    "end": 64.4,
    "text": "Nobody waiting, nobody but me"
  },
  {
    "id": "l11",
    "start": 64.4,
    "end": 69.6,
    "text": "And a dog who has never once asked me why"
  },
  {
    "id": "l12",
    "start": 69.6,
    "end": 80.0,
    "text": "We take the long way home"
  }
]
